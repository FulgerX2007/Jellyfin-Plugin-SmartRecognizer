<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.SmartRecognizer</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API docs are nice to have, not a build blocker. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin server at runtime: never copy into the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin runs on ASP.NET Core: gives System.Threading.RateLimiting without shipping a DLL. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.SmartRecognizer.Tests" />
  </ItemGroup>

</Project>
